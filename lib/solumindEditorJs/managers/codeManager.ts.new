/**
 * Code Editor Manager for SolumindEditor
 * Using CodeMirror as a lightweight alternative to Monaco
 */

import { SolumindEditor } from '../types';
import { createLightCodeEditor, prettyPrinters, CodeEditorLanguage } from '../light-editor';

export function setupCodeEditor(
  codeEditorContainer: HTMLElement,
  editor: SolumindEditor,
): void {
  // Keep track of the active tab
  let activeTab: CodeEditorLanguage = 'html';
  
  // Store editor instances
  const editorInstances: Record<string, any> = {};

  // Initialize the code editor
  function initCodeEditor(): void {
    // Create code editor elements if they don't exist
    if (!codeEditorContainer.innerHTML) {
      createCodeEditorUI();
    }

    // Add event listeners
    setupEventListeners();
  }

  // Create the code editor UI
  function createCodeEditorUI(): void {
    // Create content wrapper
    const codeEditorContent = document.createElement('div');
    codeEditorContent.className = 'solumind-code-editor-content';
    
    // Create tabs
    const tabs = document.createElement('div');
    tabs.className = 'solumind-code-editor-tabs';
    
    // HTML tab
    const htmlTab = document.createElement('button');
    htmlTab.className = 'solumind-tab active';
    htmlTab.textContent = 'HTML';
    htmlTab.setAttribute('data-tab', 'html');
    
    // CSS tab
    const cssTab = document.createElement('button');
    cssTab.className = 'solumind-tab';
    cssTab.textContent = 'CSS';
    cssTab.setAttribute('data-tab', 'css');
    
    // JS tab
    const jsTab = document.createElement('button');
    jsTab.className = 'solumind-tab';
    jsTab.textContent = 'JS';
    jsTab.setAttribute('data-tab', 'js');
    
    // Close button
    const closeBtn = document.createElement('button');
    closeBtn.className = 'solumind-code-editor-close';
    closeBtn.innerHTML = '&times;';
    closeBtn.setAttribute('title', 'Close');
    
    // Add tabs to container
    tabs.appendChild(htmlTab);
    tabs.appendChild(cssTab);
    tabs.appendChild(jsTab);
    tabs.appendChild(closeBtn);
    
    // Create editor containers
    const htmlContainer = createEditorContainer('html');
    const cssContainer = createEditorContainer('css');
    const jsContainer = createEditorContainer('js');
    
    // Initially show only HTML
    cssContainer.style.display = 'none';
    jsContainer.style.display = 'none';
    
    // Create bottom buttons
    const bottomControls = document.createElement('div');
    bottomControls.className = 'solumind-code-editor-controls';
    
    // Apply button
    const applyBtn = document.createElement('button');
    applyBtn.className = 'solumind-code-editor-apply';
    applyBtn.textContent = 'Apply Changes';
    bottomControls.appendChild(applyBtn);
    
    // Format button
    const formatBtn = document.createElement('button');
    formatBtn.className = 'solumind-code-editor-format';
    formatBtn.textContent = '✨ Format Code';
    formatBtn.style.marginLeft = '10px';
    bottomControls.appendChild(formatBtn);
    
    // Assemble editor
    codeEditorContent.appendChild(tabs);
    codeEditorContent.appendChild(htmlContainer);
    codeEditorContent.appendChild(cssContainer);
    codeEditorContent.appendChild(jsContainer);
    codeEditorContent.appendChild(bottomControls);
    
    // Add to container
    codeEditorContainer.appendChild(codeEditorContent);
    
    // Create editor instances after DOM elements are added
    setTimeout(() => {
      initEditorInstance('html', htmlContainer);
      initEditorInstance('css', cssContainer);
      initEditorInstance('js', jsContainer);
    }, 0);
  }
  
  // Create container for the editor
  function createEditorContainer(mode: CodeEditorLanguage): HTMLElement {
    const container = document.createElement('div');
    container.className = `solumind-editor-container ${mode}-editor`;
    container.setAttribute('data-mode', mode);
    container.style.height = '300px';
    container.style.border = '1px solid #333';
    container.style.borderRadius = '4px';
    container.style.overflow = 'hidden';
    return container;
  }
  
  // Initialize editor instance
  function initEditorInstance(mode: CodeEditorLanguage, container: HTMLElement): void {
    let initialContent = '';
    
    // Get initial content
    switch (mode) {
      case 'html':
        initialContent = editor.getHtml();
        break;
      case 'css':
        initialContent = editor.getCss();
        break;
      case 'js':
        initialContent = editor.getJs();
        break;
    }
    
    // Create editor
    const editorInstance = createLightCodeEditor(container, {
      value: initialContent,
      language: mode,
      onChange: (content) => {
        // Auto-update content as user types
        switch (mode) {
          case 'html':
            // Don't update HTML live to avoid flickering
            break;
          case 'css':
            // Apply CSS changes immediately
            editor.setStyle(content);
            break;
          case 'js':
            // Don't execute JS automatically for safety
            break;
        }
      }
    });
    
    // Store instance for later use
    editorInstances[mode] = editorInstance;
  }
  
  // Set up event listeners
  function setupEventListeners(): void {
    // Tab switching
    const tabs = codeEditorContainer.querySelectorAll('.solumind-tab');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const tabMode = tab.getAttribute('data-tab') as CodeEditorLanguage;
        if (tabMode) {
          switchTab(tabMode);
        }
      });
    });
    
    // Close button
    const closeBtn = codeEditorContainer.querySelector('.solumind-code-editor-close');
    if (closeBtn) {
      closeBtn.addEventListener('click', () => {
        editor.trigger('code:editor:closed');
      });
    }
    
    // Apply button
    const applyBtn = codeEditorContainer.querySelector('.solumind-code-editor-apply');
    if (applyBtn) {
      applyBtn.addEventListener('click', () => {
        applyChanges();
      });
    }
    
    // Format button
    const formatBtn = codeEditorContainer.querySelector('.solumind-code-editor-format');
    if (formatBtn) {
      formatBtn.addEventListener('click', () => {
        formatCode();
      });
    }
  }
  
  // Switch between editor tabs
  function switchTab(mode: CodeEditorLanguage): void {
    activeTab = mode;
    
    // Update tab buttons
    const tabs = codeEditorContainer.querySelectorAll('.solumind-tab');
    tabs.forEach((tab) => {
      if (tab.getAttribute('data-tab') === mode) {
        tab.classList.add('active');
      } else {
        tab.classList.remove('active');
      }
    });
    
    // Update visible editor
    const containers = codeEditorContainer.querySelectorAll('.solumind-editor-container');
    containers.forEach((container) => {
      const containerEl = container as HTMLElement;
      if (containerEl.getAttribute('data-mode') === mode) {
        containerEl.style.display = 'block';
      } else {
        containerEl.style.display = 'none';
      }
    });
  }
  
  // Apply changes from editors to the main editor
  function applyChanges(): void {
    const htmlContent = editorInstances['html']?.getValue() || '';
    const cssContent = editorInstances['css']?.getValue() || '';
    const jsContent = editorInstances['js']?.getValue() || '';
    
    // Update editor content
    editor.setComponents(htmlContent);
    editor.setStyle(cssContent);
    if (typeof editor.setJs === 'function') {
      editor.setJs(jsContent);
    }
    
    // Show success message
    showNotification('Changes applied successfully!', 'success');
  }
  
  // Format the code in the active editor
  function formatCode(): void {
    const editorInstance = editorInstances[activeTab];
    if (editorInstance && editorInstance.formatCode) {
      editorInstance.formatCode();
      showNotification(`${activeTab.toUpperCase()} code formatted successfully!`, 'success');
    } else {
      // Manually format using pretty printers
      const content = editorInstance?.getValue() || '';
      let formattedContent = content;
      
      switch (activeTab) {
        case 'html':
          formattedContent = prettyPrinters.html(content);
          break;
        case 'css':
          formattedContent = prettyPrinters.css(content);
          break;
        case 'js':
          formattedContent = prettyPrinters.js(content);
          break;
      }
      
      if (editorInstance?.setValue) {
        editorInstance.setValue(formattedContent);
        showNotification(`${activeTab.toUpperCase()} code formatted successfully!`, 'success');
      }
    }
  }
  
  // Show notification
  function showNotification(message: string, type: 'success' | 'warning' | 'error'): void {
    // Create notification element
    const notification = document.createElement('div');
    notification.className = `solumind-notification solumind-notification-${type}`;
    notification.textContent = message;
    notification.style.position = 'fixed';
    notification.style.bottom = '20px';
    notification.style.right = '20px';
    notification.style.padding = '12px 20px';
    notification.style.borderRadius = '4px';
    notification.style.zIndex = '9999';
    notification.style.opacity = '0';
    notification.style.transition = 'opacity 0.3s ease';
    
    // Set type-specific styles
    if (type === 'success') {
      notification.style.backgroundColor = '#4CAF50';
      notification.style.color = 'white';
    } else if (type === 'warning') {
      notification.style.backgroundColor = '#FF9800';
      notification.style.color = 'white';
    } else if (type === 'error') {
      notification.style.backgroundColor = '#F44336';
      notification.style.color = 'white';
    }
    
    // Add to body
    document.body.appendChild(notification);
    
    // Animate in
    setTimeout(() => {
      notification.style.opacity = '1';
    }, 10);
    
    // Remove after delay
    setTimeout(() => {
      notification.style.opacity = '0';
      setTimeout(() => {
        if (notification.parentElement) {
          notification.parentElement.removeChild(notification);
        }
      }, 300);
    }, 3000);
  }
  
  // Update editor contents when the editor content changes
  function updateEditorContents(): void {
    if (editorInstances['html']?.setValue) {
      editorInstances['html'].setValue(editor.getHtml());
    }
    
    if (editorInstances['css']?.setValue) {
      editorInstances['css'].setValue(editor.getCss());
    }
    
    if (editorInstances['js']?.setValue) {
      editorInstances['js'].setValue(editor.getJs());
    }
  }
  
  // Listen for events
  editor.on('update', updateEditorContents);
  
  editor.on('code:editor:opened', () => {
    codeEditorContainer.style.display = 'block';
    updateEditorContents();
  });
  
  editor.on('code:editor:closed', () => {
    codeEditorContainer.style.display = 'none';
  });
  
  // Initialize the editor
  initCodeEditor();
}

// Add type definition for window
declare global {
  interface Window {
    monaco?: any;
  }
}
