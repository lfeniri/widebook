{
  "name": "solumind-editor-js",
  "version": "0.1.0",
  "description": "Web page builder editor with enhanced capabilities for Next.js projects",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "Solumind Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "watch": "tsc -w",
    "test": "jest",
    "dev": "tsc -w",
    "prepare": "npm run build"
  },
  "dependencies": {
    "monaco-editor": "^0.43.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "coverageDirectory": "./coverage/",
    "collectCoverage": true,
    "collectCoverageFrom": [
      "**/*.{ts,tsx}",
      "!**/node_modules/**",
      "!**/dist/**",
      "!**/__tests__/**"
    ]
  }
}
