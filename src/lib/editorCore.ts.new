/**
 * SolumindEditor core implementation
 */

// Define types for window Monaco
declare global {
  interface Window {
    monaco: any;
    require: any;
  }
}

export function createSolumindEditor(config: any) {
  const container = typeof config.container === 'string' 
    ? document.querySelector(config.container) 
    : config.container;
  
  if (!container) {
    throw new Error('Container element not found');
  }

  // Initialize with provided content or empty strings
  let content = {
    html: config.components || '',
    css: config.style || '',
    js: config.script || ''
  };

  // Track event listeners
  const eventListeners: Record<string, Function[]> = {};

  // For auto-update and debouncing
  let autoUpdate = true;
  let updateTimeout: any = null;

  // Debounce update function
  const debounceUpdate = () => {
    if (updateTimeout) clearTimeout(updateTimeout);
    updateTimeout = setTimeout(() => {
      updatePreview();
      triggerEvent('update');
    }, 1000);
  };

  // Load Monaco editor without using workers
  const loadMonaco = () => {
    if (typeof window !== 'undefined' && !window.monaco) {
      const script = document.createElement('script');
      script.src = 'https://cdn.jsdelivr.net/npm/monaco-editor@0.43.0/min/vs/loader.js';
      script.async = true;
      script.onload = () => {
        // Configure require
        window.require.config({
          paths: {
            'vs': 'https://cdn.jsdelivr.net/npm/monaco-editor@0.43.0/min/vs'
          }
        });
        
        // Load Monaco editor
        window.require(['vs/editor/editor.main'], function() {
          // Monaco is now loaded
          document.dispatchEvent(new Event('monaco-loaded'));
        });
      };
      document.head.appendChild(script);
    }
  };

  // Initialize Monaco editor
  const initMonacoEditor = (container: HTMLElement, language: string, initialValue: string) => {
    if (!window.monaco) {
      loadMonaco();
      const handleMonacoLoad = () => {
        createMonacoInstance(container, language, initialValue);
        document.removeEventListener('monaco-loaded', handleMonacoLoad);
      };
      document.addEventListener('monaco-loaded', handleMonacoLoad);
    } else {
      createMonacoInstance(container, language, initialValue);
    }
  };

  // Create Monaco editor instance
  const createMonacoInstance = (container: HTMLElement, language: string, initialValue: string) => {
    if (!window.monaco) return;
    
    const languageMap: Record<string, string> = {
      'html': 'html',
      'css': 'css',
      'js': 'javascript'
    };
    
    const editor = window.monaco.editor.create(container, {
      value: initialValue,
      language: languageMap[language] || language,
      theme: 'vs-dark',
      automaticLayout: true,
      minimap: { enabled: false },
      scrollBeyondLastLine: false,
      fontSize: 14,
      tabSize: 2,
      wordWrap: 'on',
      contextmenu: true,
      lineNumbers: 'on',
      folding: true,
      renderIndentGuides: true,
    });
    
    // Store editor instance for later reference
    (container as any).monacoEditor = editor;
    
    // Add change listener
    editor.onDidChangeModelContent(() => {
      const value = editor.getValue();
      const editorId = container.id;
      
      if (editorId.includes('html')) {
        content.html = value;
      } else if (editorId.includes('css')) {
        content.css = value;
      } else if (editorId.includes('js')) {
        content.js = value;
      }
      
      if (autoUpdate) {
        debounceUpdate();
      }
    });
  };

  // Create editor structure
  container.innerHTML = '';
  container.classList.add('solumind-editor');
  
  // Create main layout
  const createLayout = () => {
    // Create top bar
    const topBar = document.createElement('div');
    topBar.className = 'solumind-editor-topbar';
    
    // Create tabs
    const tabsContainer = document.createElement('div');
    tabsContainer.className = 'solumind-tabs';
    
    const createTab = (name: string, isActive: boolean = false) => {
      const tab = document.createElement('button');
      tab.className = `solumind-tab ${isActive ? 'active' : ''}`;
      tab.textContent = name;
      tab.dataset.tab = name.toLowerCase();
      return tab;
    };
    
    const htmlTab = createTab('HTML', true);
    const cssTab = createTab('CSS');
    const jsTab = createTab('JS');
    const previewTab = createTab('Preview');
    
    tabsContainer.appendChild(htmlTab);
    tabsContainer.appendChild(cssTab);
    tabsContainer.appendChild(jsTab);
    tabsContainer.appendChild(previewTab);
    
    // Create actions toolbar
    const actions = document.createElement('div');
    actions.className = 'solumind-actions';
    
    const runBtn = document.createElement('button');
    runBtn.className = 'solumind-button primary';
    runBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="m11.596 8.697-6.363 3.692c-.54.313-1.233-.066-1.233-.697V4.308c0-.63.692-1.01 1.233-.696l6.363 3.692a.802.802 0 0 1 0 1.393z"/></svg> Run';
    runBtn.title = 'Execute the code and update preview';
    runBtn.id = 'solumind-run-button';
    
    const fullscreenBtn = document.createElement('button');
    fullscreenBtn.className = 'solumind-button';
    fullscreenBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M1.5 1a.5.5 0 0 0-.5.5v4a.5.5 0 0 1-1 0v-4A1.5 1.5 0 0 1 1.5 0h4a.5.5 0 0 1 0 1h-4zM10 .5a.5.5 0 0 1 .5-.5h4A1.5 1.5 0 0 1 16 1.5v4a.5.5 0 0 1-1 0v-4a.5.5 0 0 0-.5-.5h-4a.5.5 0 0 1-.5-.5zM.5 10a.5.5 0 0 1 .5.5v4a.5.5 0 0 0 .5.5h4a.5.5 0 0 1 0 1h-4A1.5 1.5 0 0 1 0 14.5v-4a.5.5 0 0 1 .5-.5zm15 0a.5.5 0 0 1 .5.5v4a1.5 1.5 0 0 1-1.5 1.5h-4a.5.5 0 0 1 0-1h4a.5.5 0 0 0 .5-.5v-4a.5.5 0 0 1 .5-.5z"/></svg>';
    fullscreenBtn.title = 'Toggle fullscreen mode';
    fullscreenBtn.id = 'solumind-fullscreen-button';
    
    actions.appendChild(runBtn);
    actions.appendChild(fullscreenBtn);
    
    topBar.appendChild(tabsContainer);
    topBar.appendChild(actions);
    
    // Create editor content
    const editorContent = document.createElement('div');
    editorContent.className = 'solumind-editor-content';
    
    // Create panels
    const createPanel = (type: string, isActive: boolean = false) => {
      const panel = document.createElement('div');
      panel.className = `solumind-panel ${isActive ? 'active' : ''}`;
      panel.dataset.panel = type;
      
      if (type !== 'preview') {
        // Create container for Monaco editor
        const editorContainer = document.createElement('div');
        editorContainer.className = 'solumind-monaco-container';
        editorContainer.id = `solumind-${type}-container`;
        editorContainer.style.width = '100%';
        editorContainer.style.height = '100%';
        
        panel.appendChild(editorContainer);
        
        // Initialize Monaco editor with delay to ensure DOM is ready
        setTimeout(() => {
          initMonacoEditor(editorContainer, type, content[type as keyof typeof content] || '');
        }, 0);
      } else {
        const previewContainer = document.createElement('div');
        previewContainer.className = 'solumind-preview-container';
        
        const previewIframe = document.createElement('iframe');
        previewIframe.className = 'solumind-preview-iframe';
        previewIframe.id = 'solumind-preview-iframe';
        previewIframe.title = 'Preview';
        
        previewContainer.appendChild(previewIframe);
        panel.appendChild(previewContainer);
      }
      
      return panel;
    };
    
    const htmlPanel = createPanel('html', true);
    const cssPanel = createPanel('css');
    const jsPanel = createPanel('js');
    const previewPanel = createPanel('preview');
    
    editorContent.appendChild(htmlPanel);
    editorContent.appendChild(cssPanel);
    editorContent.appendChild(jsPanel);
    editorContent.appendChild(previewPanel);
    
    // Add components to container
    container.appendChild(topBar);
    container.appendChild(editorContent);
  };
  
  // Create the layout
  createLayout();
  
  // Setup event handlers
  const setupEventHandlers = () => {
    // Get elements
    const tabs = container.querySelectorAll('.solumind-tab');
    const panels = container.querySelectorAll('.solumind-panel');
    const runButton = document.getElementById('solumind-run-button');
    const fullscreenButton = document.getElementById('solumind-fullscreen-button');
    const previewIframe = document.getElementById('solumind-preview-iframe') as HTMLIFrameElement;
    
    // Tab switching logic
    tabs.forEach((tab: Element) => {
      tab.addEventListener('click', () => {
        const tabId = (tab as HTMLElement).dataset.tab;
        
        // Update active tab
        tabs.forEach((t: Element) => t.classList.remove('active'));
        tab.classList.add('active');
        
        // Show corresponding panel
        panels.forEach((panel: Element) => {
          if ((panel as HTMLElement).dataset.panel === tabId) {
            panel.classList.add('active');
          } else {
            panel.classList.remove('active');
          }
        });
        
        // If switching to preview tab, update the preview
        if (tabId === 'preview') {
          updatePreview();
        }
      });
    });
    
    // Run button functionality
    if (runButton) {
      runButton.addEventListener('click', () => {
        updatePreview();
        triggerEvent('update');
      });
    }
    
    // Fullscreen functionality
    let isFullscreen = false;
    if (fullscreenButton) {
      fullscreenButton.addEventListener('click', () => {
        isFullscreen = !isFullscreen;
        container.classList.toggle('solumind-fullscreen', isFullscreen);
        triggerEvent('resize');
      });
    }
    
    // Handle Escape key to exit fullscreen
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isFullscreen) {
        isFullscreen = false;
        container.classList.remove('solumind-fullscreen');
        triggerEvent('resize');
      }
    });
  };
  
  setupEventHandlers();
  
  // Function to update preview
  function updatePreview() {
    const iframe = document.getElementById('solumind-preview-iframe') as HTMLIFrameElement;
    if (!iframe) return;
    
    const html = content.html;
    const css = content.css;
    const js = content.js;
    
    // Create preview document
    const preview = `
      <!DOCTYPE html>
      <html>
        <head>
          <meta charset="UTF-8">
          <meta name="viewport" content="width=device-width, initial-scale=1.0">
          <title>Preview</title>
          ${config.canvas && config.canvas.styles ? 
            config.canvas.styles.map((style: string) => 
              `<link rel="stylesheet" href="${style}">`
            ).join('') 
            : ''}
          <style>${css}</style>
        </head>
        <body>
          ${html}
          <script>${js}</script>
        </body>
      </html>
    `;
    
    // Update iframe content
    const iframeDoc = iframe.contentDocument || iframe.contentWindow?.document;
    if (iframeDoc) {
      iframeDoc.open();
      iframeDoc.write(preview);
      iframeDoc.close();
    }
  }
  
  // Event handling
  function on(event: string, callback: Function) {
    if (!eventListeners[event]) {
      eventListeners[event] = [];
    }
    eventListeners[event].push(callback);
  }
  
  function off(event: string, callback: Function) {
    if (eventListeners[event]) {
      eventListeners[event] = eventListeners[event].filter(cb => cb !== callback);
    }
  }
  
  function triggerEvent(event: string, ...args: any[]) {
    if (eventListeners[event]) {
      eventListeners[event].forEach(callback => callback(...args));
    }
  }
  
  // Get editor content
  function getHtml() {
    return content.html;
  }
  
  function getCss() {
    return content.css;
  }
  
  function getJs() {
    return content.js;
  }
  
  // Set editor content
  function setComponents(html: string) {
    content.html = html;
    
    // Update the editor if it exists
    const container = document.getElementById('solumind-html-container');
    if (container && (container as any).monacoEditor) {
      (container as any).monacoEditor.setValue(html);
    }
    
    updatePreview();
    triggerEvent('update');
  }
  
  function setStyle(css: string) {
    content.css = css;
    
    // Update the editor if it exists
    const container = document.getElementById('solumind-css-container');
    if (container && (container as any).monacoEditor) {
      (container as any).monacoEditor.setValue(css);
    }
    
    updatePreview();
    triggerEvent('update');
  }
  
  function setJs(js: string) {
    content.js = js;
    
    // Update the editor if it exists
    const container = document.getElementById('solumind-js-container');
    if (container && (container as any).monacoEditor) {
      (container as any).monacoEditor.setValue(js);
    }
    
    updatePreview();
    triggerEvent('update');
  }
  
  // Return public API
  return {
    getHtml,
    getCss,
    getJs,
    setComponents,
    setStyle,
    setJs,
    on,
    off,
    trigger: triggerEvent,
    getWrapper: () => container,
    getContainer: () => container,
    closeCodeEditor: () => {},
    destroy: () => {
      // Clean up event listeners
      container.innerHTML = '';
    }
  };
}
